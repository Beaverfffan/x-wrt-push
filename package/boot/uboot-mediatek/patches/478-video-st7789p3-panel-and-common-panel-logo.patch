--- /dev/null
+++ b/drivers/video/st7789p3.c
@@ -0,0 +1,401 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Sitronix ST7789P3 over SPI in MIPI DBI type C mode.
+ *
+ * The MediaTek SPIM controller implements only the spi-mem API, so transfers go
+ * through spi_mem_exec_op() rather than dm_spi_xfer(). A spi_mem_op must carry
+ * exactly one opcode byte, so the first byte of every burst rides in that slot;
+ * on the wire it is indistinguishable from a raw transfer.
+ *
+ * A skip-init property says an earlier stage already brought the panel up and
+ * left a picture on it. The reset and the init sequence are then left out, and
+ * the first frame goes straight at a running controller. The panel is
+ * write-only, so the claim cannot be checked here.
+ */
+
+#include <backlight.h>
+#include <dm.h>
+#include <log.h>
+#include <malloc.h>
+#include <mipi_display.h>
+#include <spi.h>
+#include <spi-mem.h>
+#include <video.h>
+#include <asm/gpio.h>
+#include <dm/device_compat.h>
+#include <linux/delay.h>
+#include <linux/kernel.h>
+
+#define ST7789P3_WIDTH		320
+#define ST7789P3_HEIGHT		240
+#define ST7789P3_BYTES_PER_PX	2
+#define ST7789P3_LINE_BYTES	(ST7789P3_WIDTH * ST7789P3_BYTES_PER_PX)
+
+/* mtk_spim_supports_op() takes 1..65536 data bytes freely, then only exact
+ * multiples of 65536, so a 153600 byte frame has to be split.
+ */
+#define ST7789P3_CHUNK		65536
+#define ST7789P3_CHUNK_LINES	(ST7789P3_CHUNK / ST7789P3_LINE_BYTES)
+#define ST7789P3_BUF_BYTES	(ST7789P3_CHUNK_LINES * ST7789P3_LINE_BYTES)
+
+#define ST7789P3_DELAY		0x00
+
+/*
+ * The controller's command timing is far tighter than its pixel timing, so
+ * anything short goes out slowly and only bulk pixel data runs at full speed,
+ * as mipi_dbi_spi_cmd_max_speed() does in Linux.
+ */
+#define ST7789P3_SLOW_MAX_LEN	64
+#define ST7789P3_SLOW_HZ	10000000
+
+struct st7789p3_priv {
+	struct gpio_desc reset_gpio;
+	struct gpio_desc dc_gpio;
+	struct udevice *backlight;
+	struct spi_slave *slave;
+	uint max_hz;
+	u8 *buf;
+	u8 madctl;
+	bool skip_init;
+	bool inited;
+	bool lit;
+};
+
+/*
+ * Both values set MV, so both give 320x240 landscape. The panel that is mounted
+ * the other way up needs the other one, and the two Linux panel-mipi-dbi blobs
+ * differ in this byte alone.
+ */
+#define ST7789P3_MADCTL_90	0x60	/* MV|MX */
+#define ST7789P3_MADCTL_270	0xa0	/* MV|MY */
+
+/*
+ * Transcribed from package/firmware/glinet-panel-firmware/gen-panel-fw.py, which
+ * builds the same sequence as the panel-mipi-dbi blob Linux loads. Records are
+ * <cmd> <nparams> <params...>; ST7789P3_DELAY carries milliseconds instead.
+ * MADCTL is the one byte the board supplies, so the table leaves it at zero.
+ */
+static const u8 st7789p3_init_seq[] = {
+	MIPI_DCS_SOFT_RESET, 0,
+	ST7789P3_DELAY, 1, 5,
+	MIPI_DCS_EXIT_SLEEP_MODE, 0,
+	ST7789P3_DELAY, 1, 120,
+	MIPI_DCS_SET_ADDRESS_MODE, 1, 0x00,
+	MIPI_DCS_SET_PIXEL_FORMAT, 1, 0x05,
+	0xb2, 5, 0x05, 0x05, 0x00, 0x33, 0x33,		/* PORCTRL */
+	0xb7, 1, 0x35,					/* GCTRL */
+	0xbb, 1, 0x21,					/* VCOMS */
+	0xc0, 1, 0x2c,					/* LCMCTRL */
+	0xc2, 1, 0x01,					/* VDVVRHEN */
+	0xc3, 1, 0x0b,					/* VRHS */
+	0xc4, 1, 0x20,					/* VDVS */
+	0xc6, 1, 0x0a,					/* FRCTRL2 */
+	0xd0, 2, 0xa7, 0xa1,				/* PWCTRL1 */
+	0xd0, 2, 0xa4, 0xa1,				/* PWCTRL1 */
+	MIPI_DCS_SET_TEAR_ON, 1, 0x00,
+	0xd6, 1, 0xa1,					/* vendor */
+	0xe0, 14, 0xd0, 0x04, 0x08, 0x0a, 0x09, 0x05, 0x2d,
+		  0x43, 0x49, 0x09, 0x16, 0x15, 0x26, 0x2b,	/* PVGAMCTRL */
+	0xe1, 14, 0xd0, 0x03, 0x09, 0x0a, 0x0a, 0x06, 0x2e,
+		  0x44, 0x40, 0x3a, 0x15, 0x15, 0x26, 0x2a,	/* NVGAMCTRL */
+	MIPI_DCS_ENTER_INVERT_MODE, 0,
+	ST7789P3_DELAY, 1, 10,
+	MIPI_DCS_SET_DISPLAY_ON, 0,
+	ST7789P3_DELAY, 1, 120,
+};
+
+static int st7789p3_exec(struct st7789p3_priv *priv, struct spi_mem_op *op,
+			 size_t len)
+{
+	int ret;
+
+	priv->slave->max_hz = len > ST7789P3_SLOW_MAX_LEN ? priv->max_hz :
+			      min_t(uint, priv->max_hz, ST7789P3_SLOW_HZ);
+
+	ret = spi_mem_exec_op(priv->slave, op);
+	priv->slave->max_hz = priv->max_hz;
+
+	return ret;
+}
+
+static int st7789p3_write_cmd(struct udevice *dev, u8 cmd)
+{
+	struct st7789p3_priv *priv = dev_get_priv(dev);
+	struct spi_mem_op op = SPI_MEM_OP(SPI_MEM_OP_CMD(cmd, 1),
+					  SPI_MEM_OP_NO_ADDR,
+					  SPI_MEM_OP_NO_DUMMY,
+					  SPI_MEM_OP_NO_DATA);
+	int ret;
+
+	ret = dm_gpio_set_value(&priv->dc_gpio, 0);
+	if (ret)
+		return ret;
+
+	return st7789p3_exec(priv, &op, 1);
+}
+
+static int st7789p3_write_data(struct udevice *dev, const u8 *buf, size_t len)
+{
+	struct st7789p3_priv *priv = dev_get_priv(dev);
+	int ret;
+
+	if (!len)
+		return 0;
+
+	ret = dm_gpio_set_value(&priv->dc_gpio, 1);
+	if (ret)
+		return ret;
+
+	while (len) {
+		size_t n = min(len, (size_t)ST7789P3_CHUNK);
+		struct spi_mem_op op = SPI_MEM_OP(SPI_MEM_OP_CMD(buf[0], 1),
+						  SPI_MEM_OP_NO_ADDR,
+						  SPI_MEM_OP_NO_DUMMY,
+						  SPI_MEM_OP_NO_DATA);
+
+		/*
+		 * exec_op picks the no-data register flag off data.nbytes but
+		 * its completion wait off data.dir, so the two have to agree.
+		 */
+		if (n > 1) {
+			op.data.dir = SPI_MEM_DATA_OUT;
+			op.data.nbytes = n - 1;
+			op.data.buf.out = buf + 1;
+			op.data.buswidth = 1;
+		}
+
+		ret = st7789p3_exec(priv, &op, n);
+		if (ret)
+			return ret;
+
+		buf += n;
+		len -= n;
+	}
+
+	return 0;
+}
+
+static int st7789p3_init_display(struct udevice *dev)
+{
+	struct st7789p3_priv *priv = dev_get_priv(dev);
+	size_t i = 0;
+	int ret;
+
+	while (i < ARRAY_SIZE(st7789p3_init_seq)) {
+		u8 cmd = st7789p3_init_seq[i++];
+		u8 len = st7789p3_init_seq[i++];
+
+		if (cmd == ST7789P3_DELAY) {
+			mdelay(st7789p3_init_seq[i]);
+			i += len;
+			continue;
+		}
+
+		ret = st7789p3_write_cmd(dev, cmd);
+		if (ret)
+			return ret;
+
+		if (cmd == MIPI_DCS_SET_ADDRESS_MODE)
+			ret = st7789p3_write_data(dev, &priv->madctl, 1);
+		else
+			ret = st7789p3_write_data(dev, &st7789p3_init_seq[i],
+						  len);
+		if (ret)
+			return ret;
+
+		i += len;
+	}
+
+	return 0;
+}
+
+static int st7789p3_set_window(struct udevice *dev)
+{
+	u8 col[4] = { 0, 0, (ST7789P3_WIDTH - 1) >> 8,
+		      (ST7789P3_WIDTH - 1) & 0xff };
+	u8 row[4] = { 0, 0, (ST7789P3_HEIGHT - 1) >> 8,
+		      (ST7789P3_HEIGHT - 1) & 0xff };
+	int ret;
+
+	ret = st7789p3_write_cmd(dev, MIPI_DCS_SET_COLUMN_ADDRESS);
+	if (ret)
+		return ret;
+	ret = st7789p3_write_data(dev, col, sizeof(col));
+	if (ret)
+		return ret;
+
+	ret = st7789p3_write_cmd(dev, MIPI_DCS_SET_PAGE_ADDRESS);
+	if (ret)
+		return ret;
+
+	return st7789p3_write_data(dev, row, sizeof(row));
+}
+
+static int st7789p3_sync(struct udevice *vid)
+{
+	struct video_priv *uc_priv = dev_get_uclass_priv(vid);
+	struct st7789p3_priv *priv = dev_get_priv(vid);
+	const u8 *fb = uc_priv->fb;
+	size_t fill = 0;
+	int y, ret;
+
+	/* video_post_probe() clears the screen, so this runs before probe ends */
+	if (!priv->inited)
+		return 0;
+
+	ret = st7789p3_set_window(vid);
+	if (ret)
+		return ret;
+
+	ret = st7789p3_write_cmd(vid, MIPI_DCS_WRITE_MEMORY_START);
+	if (ret)
+		return ret;
+
+	for (y = 0; y < ST7789P3_HEIGHT; y++) {
+		const u8 *src = fb + y * uc_priv->line_length;
+		int x;
+
+		/* framebuffer RGB565 is little endian, the panel wants MSB first */
+		for (x = 0; x < ST7789P3_WIDTH; x++) {
+			priv->buf[fill++] = src[x * 2 + 1];
+			priv->buf[fill++] = src[x * 2];
+		}
+
+		if (fill + ST7789P3_LINE_BYTES > ST7789P3_BUF_BYTES ||
+		    y == ST7789P3_HEIGHT - 1) {
+			ret = st7789p3_write_data(vid, priv->buf, fill);
+			if (ret)
+				return ret;
+			fill = 0;
+		}
+	}
+
+	if (!priv->lit && priv->backlight) {
+		priv->lit = true;
+		backlight_enable(priv->backlight);
+	}
+
+	return 0;
+}
+
+static int st7789p3_probe(struct udevice *dev)
+{
+	struct video_priv *uc_priv = dev_get_uclass_priv(dev);
+	struct st7789p3_priv *priv = dev_get_priv(dev);
+	int ret;
+
+	priv->slave = dev_get_parent_priv(dev);
+	if (!priv->slave)
+		return -ENODEV;
+
+	priv->max_hz = priv->slave->max_hz;
+	priv->skip_init = dev_read_bool(dev, "skip-init");
+
+	switch (dev_read_u32_default(dev, "rotation", 0)) {
+	case 90:
+		priv->madctl = ST7789P3_MADCTL_90;
+		break;
+	case 270:
+		priv->madctl = ST7789P3_MADCTL_270;
+		break;
+	default:
+		dev_err(dev, "rotation has to be 90 or 270\n");
+		return -EINVAL;
+	}
+
+	/*
+	 * Requesting an output drives it, and logical 0 is RESX asserted, so an
+	 * adopted panel has to be asked for released or the request alone wipes
+	 * the picture.
+	 */
+	ret = gpio_request_by_name(dev, "reset-gpios", 0, &priv->reset_gpio,
+				   priv->skip_init ?
+				   GPIOD_IS_OUT | GPIOD_IS_OUT_ACTIVE :
+				   GPIOD_IS_OUT);
+	if (ret) {
+		dev_err(dev, "cannot get reset GPIO: %d\n", ret);
+		return ret;
+	}
+
+	ret = gpio_request_by_name(dev, "dc-gpios", 0, &priv->dc_gpio,
+				   GPIOD_IS_OUT);
+	if (ret) {
+		dev_err(dev, "cannot get dc GPIO: %d\n", ret);
+		goto free_reset;
+	}
+
+	ret = uclass_get_device_by_phandle(UCLASS_PANEL_BACKLIGHT, dev,
+					   "backlight", &priv->backlight);
+	if (ret && ret != -ENOENT)
+		dev_err(dev, "cannot get backlight: %d\n", ret);
+
+	priv->buf = malloc(ST7789P3_BUF_BYTES);
+	if (!priv->buf) {
+		ret = -ENOMEM;
+		goto free_dc;
+	}
+
+	uc_priv->bpix = VIDEO_BPP16;
+	uc_priv->xsize = ST7789P3_WIDTH;
+	uc_priv->ysize = ST7789P3_HEIGHT;
+	uc_priv->rot = 0;
+
+	/* an earlier stage already lit the backlight it left the picture under */
+	priv->lit = priv->skip_init;
+
+	if (!priv->skip_init) {
+		/* RESX is active low, so released is 1, as mipi_dbi_hw_reset() */
+		dm_gpio_set_value(&priv->reset_gpio, 0);
+		mdelay(1);
+		dm_gpio_set_value(&priv->reset_gpio, 1);
+		mdelay(120);
+
+		ret = st7789p3_init_display(dev);
+		if (ret) {
+			dev_err(dev, "init sequence failed: %d\n", ret);
+			goto free_buf;
+		}
+	}
+
+	priv->inited = true;
+
+	return 0;
+
+free_buf:
+	free(priv->buf);
+free_dc:
+	dm_gpio_free(dev, &priv->dc_gpio);
+free_reset:
+	/* DM frees priv on a failed probe, so release these or a retry sees -EBUSY */
+	dm_gpio_free(dev, &priv->reset_gpio);
+
+	return ret;
+}
+
+static int st7789p3_bind(struct udevice *dev)
+{
+	struct video_uc_plat *plat = dev_get_uclass_plat(dev);
+
+	plat->size = ST7789P3_WIDTH * ST7789P3_HEIGHT * ST7789P3_BYTES_PER_PX;
+
+	return 0;
+}
+
+static const struct video_ops st7789p3_ops = {
+	.video_sync = st7789p3_sync,
+};
+
+static const struct udevice_id st7789p3_ids[] = {
+	{ .compatible = "sitronix,st7789p3" },
+	{ }
+};
+
+U_BOOT_DRIVER(st7789p3_video) = {
+	.name = "st7789p3_video",
+	.id = UCLASS_VIDEO,
+	.of_match = st7789p3_ids,
+	.ops = &st7789p3_ops,
+	.bind = st7789p3_bind,
+	.probe = st7789p3_probe,
+	.priv_auto = sizeof(struct st7789p3_priv),
+};

--- /dev/null
+++ b/board/mediatek/common/panel_logo.c
@@ -0,0 +1,115 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (C) 2026 OpenWrt.org
+ *
+ * Draws the OpenWrt logo and the stage name on an ST7789P3 front panel. The
+ * boards that carry one share the picture, the text position and the panel
+ * geometry, so only the calls into here belong in a board file.
+ */
+
+#include <bootm.h>
+#include <dm.h>
+#include <image.h>
+#include <mapmem.h>
+#include <splash.h>
+#include <version.h>
+#include <video.h>
+#include <video_console.h>
+#include <linux/libfdt.h>
+
+#include "panel_logo.h"
+
+/* openwrt_logo.bmp, incbin'd by the .bmp.o rule in Makefile.lib-u-boot */
+extern u8 __splash_openwrt_logo_begin[];
+
+/*
+ * Only claimed when the panel actually came up under us. A static property
+ * would be a promise that U-Boot ran, which is false for netboot or recovery,
+ * and the panel is write-only so the kernel cannot check for itself.
+ */
+void fdt_mark_panel_initialised(void *blob)
+{
+	struct udevice *vid;
+	int node;
+
+	vid = uclass_try_first_device(UCLASS_VIDEO);
+	if (!vid || !device_active(vid))
+		return;
+
+	node = fdt_node_offset_by_compatible(blob, -1, "panel-mipi-dbi-spi");
+	if (node < 0)
+		return;
+
+	if (fdt_setprop_empty(blob, node, "bootloader-initialized"))
+		printf("cannot mark the panel as initialised\n");
+}
+
+/*
+ * The first scanline clear of the centred 280x83 logo, rounded up to the 8x16
+ * font cell. scripts/gen-boot-logos.py in the OpenWrt tree puts the BL2 text
+ * band at the same y with the same glyphs, so changing CONFIG_VIDEO_FONT_* here
+ * needs the BL2 blob regenerated too.
+ */
+#define PANEL_TEXT_Y		176
+
+static void panel_text(struct udevice *vid, const char *text)
+{
+	struct video_priv *vid_priv = dev_get_uclass_priv(vid);
+	struct vidconsole_priv *cons;
+	struct udevice *con;
+	int len = strlen(text);
+	int max, x;
+
+	if (uclass_first_device_err(UCLASS_VIDEO_CONSOLE, &con))
+		return;
+
+	cons = dev_get_uclass_priv(con);
+	max = vid_priv->xsize / cons->x_charsize;
+	x = len < max ? (vid_priv->xsize - len * cons->x_charsize) / 2 : 0;
+
+	vidconsole_set_cursor_pos(con, x, PANEL_TEXT_Y);
+	vidconsole_put_stringn(con, text, max);
+}
+
+/*
+ * Order matters. video_sync() runs the driver blit before it looks at its own
+ * rate limit, and CONFIG_CYCLIC is off here, so every call puts a whole 320x240
+ * frame on the wire, which is 24 ms the eye can see. video_fill_part() and
+ * vidconsole_put_stringn() only touch the framebuffer. video_bmp_display() ends
+ * in video_sync(), so it goes last and its sync is the only blit of the frame.
+ *
+ * NO_FB_CLEAR keeps the BL2 picture on the panel through probe, so nothing has
+ * painted the framebuffer and the background is laid down here.
+ */
+static void panel_draw(const char *text)
+{
+	struct video_priv *priv;
+	struct udevice *vid;
+
+	if (uclass_first_device_err(UCLASS_VIDEO, &vid))
+		return;
+
+	priv = dev_get_uclass_priv(vid);
+	video_fill_part(vid, 0, 0, priv->xsize, priv->ysize, priv->colour_bg);
+
+	panel_text(vid, text);
+	video_bmp_display(vid, map_to_sysmem(__splash_openwrt_logo_begin),
+			  BMP_ALIGN_CENTER, BMP_ALIGN_CENTER, true);
+}
+
+void board_show_logo(void)
+{
+	panel_draw(PLAIN_VERSION);
+}
+
+/* The panel keeps this picture until Linux hands over to whatever draws next */
+void board_preboot_os(void)
+{
+	char *desc;
+
+	if (!images.fit_hdr_os ||
+	    fit_get_desc(images.fit_hdr_os, images.fit_noffset_os, &desc))
+		desc = "Booting Linux";
+
+	panel_draw(desc);
+}

